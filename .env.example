# Copy this file to `.env` and fill in real values. NEVER put real values in this template: it is committed to git.

# ---- Supabase (free tier) ----
# Supabase dashboard -> Connect -> Direct -> Transaction pooler (port 6543). Replace [YOUR-PASSWORD]; if it has special
# characters (# ? / & @) URL-encode them, or better, use a password with only letters and digits.
# Used by the Python worker. The Next.js dashboard reads its own web/.env.local and should use the SESSION pooler (port 5432).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

# ---- Dashboard login (HTTP Basic auth: any username, this password). Required in production builds. ----
APP_PASSWORD=choose-a-long-random-password

# ---- Research data keys (free). Worker-side ONLY: do not add these to Vercel; the dashboard never uses them ----
FRED_API_KEY=
CONGRESS_API_KEY=
